---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader from "../../components/SiteHeader.astro"; import SiteFooter from "../../components/SiteFooter.astro"; import { categories } from "../../config/site"; import { articles } from "../../data/articles";
export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug }, props: { category } })); } const { category } = Astro.props; const entries = articles.filter((article) => article.categorySlug === category.slug);
---
<BaseLayout title={`${category.name} | Lo importante de hoy`} description={`Ediciones y artículos de ${category.name} en Lo importante de hoy.`}><SiteHeader /><main class="category-page"><header class="page-hero"><p class="eyebrow">CATEGORÍA</p><h1>{category.name}</h1><p>Historias para entender el presente con memoria, contexto y curiosidad.</p></header><section class="category-results">{entries.length ? entries.map((article) => <article><p class="eyebrow">EDICIÓN Nº {article.number} · {article.readTime} MIN</p><h2><a href={`/ediciones/${article.slug}`}>{article.title}</a></h2><p>{article.description}</p><a class="text-link" href={`/ediciones/${article.slug}`}>Leer la introducción <span>↗</span></a></article>) : <div class="empty-edition"><span>PRÓXIMAMENTE</span><h2>Estamos preparando esta parte de la biblioteca.</h2><p>La categoría ya forma parte de la arquitectura editorial y recibirá nuevas ediciones.</p><a href="/ediciones">Explorar el archivo</a></div>}</section></main><SiteFooter /></BaseLayout>
