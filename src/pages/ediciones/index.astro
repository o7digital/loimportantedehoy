---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { articles } from "../../data/articles";
import { magazines } from "../../data/magazines";
---
<BaseLayout title="Todas las ediciones | Lo importante de hoy" description="Explora el archivo de cultura, historia, música, personajes e ideas.">
  <SiteHeader />
  <main class="archive-page">
    <header class="page-hero"><div class="section-index light">ARCHIVO <span></span> 2026</div><h1>Ediciones para<br /><em>volver a ellas.</em></h1><p>Una biblioteca de historias que no caducan cuando termina el día.</p></header>
    <section class="archive-list" aria-label="Revistas para hojear">
      <p class="section-index light">LA REVISTA <span></span> PÁGINA A PÁGINA</p>
      {magazines.map((edition, index) => <article class="archive-item">
        <a class="archive-art" href={`/revista/${edition.slug}`} aria-label={`Hojear la revista de ${edition.title}`}><img src={edition.image} alt={`Portada original de ${edition.title}`} width="1024" height="1280" loading={index === 0 ? "eager" : "lazy"} style="object-fit:contain;object-position:left" /></a>
        <div><p class="eyebrow"><time datetime={edition.date}>{edition.dateLabel}</time> · {edition.category}</p><h2><a href={`/revista/${edition.slug}`}>{edition.title}</a></h2><p>{edition.subtitle}</p><a class="text-link" href={`/revista/${edition.slug}`}>Hojear la revista <span>↗</span></a></div>
      </article>)}
    </section>
    <section class="archive-list" aria-label="Artículos del archivo">
      <p class="section-index light">EL ARCHIVO <span></span> PARA SEGUIR LEYENDO</p>
      {articles.map((article, index) => <article class="archive-item"><a class="archive-art" href={`/ediciones/${article.slug}`} aria-label={`Leer ${article.title}`}>{article.image ? <img src={article.image} alt={`Portada de ${article.title}`} width="600" height="760" loading="lazy" /> : <span class={`edition-art art-${index + 1}`}><i></i><b>{article.category}</b></span>}</a><div><p class="eyebrow">Nº {article.number} · {article.category}</p><h2><a href={`/ediciones/${article.slug}`}>{article.title}</a></h2><p>{article.description}</p><a class="text-link" href={`/ediciones/${article.slug}`}>Abrir edición <span>↗</span></a></div></article>)}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
