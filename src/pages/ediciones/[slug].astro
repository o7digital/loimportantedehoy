---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { articles, type Article } from "../../data/articles";
import { site } from "../../config/site";

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
const isDoors = article.slug === "the-doors-disolucion-1973";
const url = `${site.url}/ediciones/${article.slug}`;
const related = articles.filter((item) => item.slug !== article.slug).slice(0, 3);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", headline: article.title, description: article.description, datePublished: article.published, dateModified: article.updated, author: { "@type": "Organization", name: article.author }, publisher: { "@type": "Organization", name: site.name }, mainEntityOfPage: url, about: isDoors ? ["The Doors", "Jim Morrison", "Disolución de The Doors"] : article.category },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: site.url }, { "@type": "ListItem", position: 2, name: "Ediciones", item: `${site.url}/ediciones` }, { "@type": "ListItem", position: 3, name: article.title, item: url }] },
];
---
<BaseLayout title={article.seoTitle} description={article.description} canonical={`/ediciones/${article.slug}`} type="article" jsonLd={jsonLd}>
  <SiteHeader />
  <main class="article-page">
    <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/ediciones">Ediciones</a><span>/</span><span aria-current="page">Nº {article.number}</span></nav>
    <header class="article-hero">
      <div class="article-heading">
        <p class="eyebrow">{isDoors ? "HISTORIA DE LA MÚSICA · 30 DE AGOSTO DE 1973" : `EDICIÓN Nº ${article.number} · ${article.category}`}</p>
        <h1>{article.title}</h1><p class="article-deck">{article.excerpt}</p>
        <div class="article-meta"><span>Por {article.author}</span>{article.historicalDate && <span>Fecha histórica: <time datetime={article.historicalDate}>30 agosto 1973</time></span>}<span>Publicado en la revista: <time datetime={article.published}>30 agosto 2026</time></span><span>{article.readTime} min de lectura</span><a href={`/categorias/${article.categorySlug}`}>{article.category}</a></div>
      </div>
      <div class="article-symbol doors-symbol" aria-label="Composición tipográfica The Doors — 1973"><small>THE</small><strong>DOORS</strong><i></i><span>1973</span></div>
    </header>
    <article class="article-body">
      <div class="share-quote"><span>PARA COMPARTIR</span><blockquote>“{article.excerpt}”</blockquote></div>
      <div class="prose free-intro">{article.intro.map((paragraph, index) => index === 0 ? <p class="lead">{paragraph}</p> : <p>{paragraph}</p>)}</div>
      {isDoors ? <>
        <section class="prose article-section"><h2>La historia detrás de la separación</h2><p>Tras la muerte de Jim Morrison el 3 de julio de 1971 en París, Ray Manzarek, Robby Krieger y John Densmore decidieron continuar como trío. Publicaron los álbumes <cite>Other Voices</cite> en 1971 y <cite>Full Circle</cite> en 1972.</p><p>Aunque los músicos intentaron mantener vivo el proyecto, la identidad de The Doors estaba profundamente vinculada a la voz, la presencia y la escritura de Morrison. La recepción de los nuevos trabajos confirmó que el grupo había entrado en una etapa completamente diferente.</p><p>Finalmente, el 30 de agosto de 1973 se anunció oficialmente la disolución de la banda.</p></section>
        <section class="prose article-section"><h2>Jim Morrison, poeta y símbolo de una generación</h2><div class="profile-card"><span>JIM MORRISON</span><strong>1943–1971</strong><p>Cantante, poeta y símbolo de una generación.</p></div><p>Como cantante y principal letrista, Morrison dio a The Doors una identidad construida entre la poesía, el teatro y la provocación. Su voz y su presencia escénica no fueron un elemento intercambiable: definieron la tensión que distinguía al grupo y condicionaron cualquier intento de continuar después de su muerte.</p></section>
        <section class="premium-gate" aria-label="Continuación para miembros"><div class="doors-premium-preview" aria-hidden="true">
          <section class="article-section"><h2>Los álbumes esenciales de The Doors</h2><div class="album-grid">{[["The Doors","1967"],["Strange Days","1967"],["Waiting for the Sun","1968"],["L.A. Woman","1971"]].map(([name, year], index) => <article><small>0{index + 1}</small><strong>{name}</strong><span>{year}</span></article>)}</div></section>
          <section class="article-section quotes-section"><h2>Frases que siguen resonando</h2><blockquote>“La única libertad real consiste en descubrir quién eres realmente.”<cite>— Atribuida a Jim Morrison</cite></blockquote><blockquote>“El futuro es incierto, pero el final siempre está cerca.”<cite>— Atribuida a Jim Morrison</cite></blockquote><blockquote>“Algunos de los peores errores de mi vida fueron increíbles.”<cite>— Atribuida a Jim Morrison</cite></blockquote><p class="source-note">Nota editorial: estas frases circulan atribuidas a Jim Morrison; su formulación exacta requiere una fuente primaria confirmada.</p></section>
          <section class="article-section"><h2>La canción que marcó el final</h2><div class="music-card"><span aria-hidden="true">♪</span><div><small>THE DOORS</small><strong>The End</strong><p>Enlace oficial pendiente de incorporar.</p></div><button type="button" disabled aria-disabled="true">Escuchar próximamente</button></div></section>
          <section class="article-section"><h2>El legado de The Doors</h2><p>The Doors unió poesía, rock y rebeldía como pocas bandas de su época. Décadas después de su separación, su música continúa formando parte de la cultura popular y sigue inspirando a nuevas generaciones de artistas y oyentes.</p><blockquote class="closing-quote">“Ellos abrieron la puerta. Y el rock ya nunca volvió a ser el mismo.”</blockquote></section>
        </div><div class="gate-card"><span class="prism" aria-hidden="true"><span class="prism-beam"></span></span><p class="eyebrow">CONTENIDO PARA MIEMBROS</p><h2>La historia continúa.</h2><p>Descubre los álbumes esenciales, las frases, la canción y el legado de The Doors. Accede por ${site.membership.price} {site.membership.currency} al mes.</p><a class="button button-red" href="/membresia">Continuar con la membresía <span>↗</span></a><a href="/acceder">Ya soy miembro: acceder</a></div></section>
      </> : <section class="premium-gate"><div class="premium-preview" aria-hidden="true">{article.premium.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((p) => <p>{p}</p>)}</section>)}</div><div class="gate-card"><p class="eyebrow">CONTENIDO PARA MIEMBROS</p><h2>La historia continúa.</h2><p>Accede a la edición completa y al archivo por ${site.membership.price} {site.membership.currency} al mes.</p><a class="button button-red" href="/membresia">Hazte miembro <span>↗</span></a></div></section>}
      <p class="updated">Última actualización: <time datetime={article.updated}>{article.updated}</time></p>
    </article>
    <aside class="related"><p class="section-index">SIGUE LEYENDO <span></span> EL ARCHIVO</p><h2>Artículos relacionados</h2><div>{related.map((item) => <a href={`/ediciones/${item.slug}`}><small>{item.category} · {item.readTime} min</small><strong>{item.title}</strong><span>↗</span></a>)}</div></aside>
  </main><SiteFooter />
</BaseLayout>
