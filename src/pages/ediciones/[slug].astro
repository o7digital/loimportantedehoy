---
import BaseLayout from "../../layouts/BaseLayout.astro"; import SiteHeader from "../../components/SiteHeader.astro"; import SiteFooter from "../../components/SiteFooter.astro"; import { articles, type Article } from "../../data/articles"; import { site } from "../../config/site";
export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug }, props: { article } })); }
const { article } = Astro.props as { article: Article }; const url = `${site.url}/ediciones/${article.slug}`; const related = articles.filter((item) => item.slug !== article.slug).slice(0, 3);
const jsonLd = [{ "@context": "https://schema.org", "@type": "Article", headline: article.title, description: article.description, image: article.image ? new URL(article.image, site.url).toString() : undefined, datePublished: article.published, dateModified: article.updated, author: { "@type": "Organization", name: article.author }, publisher: { "@type": "Organization", name: site.name }, mainEntityOfPage: url }, { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: site.url }, { "@type": "ListItem", position: 2, name: "Ediciones", item: `${site.url}/ediciones` }, { "@type": "ListItem", position: 3, name: article.title, item: url }] }];
---
<BaseLayout title={article.seoTitle} description={article.description} image={article.image} canonical={`/ediciones/${article.slug}`} type="article" jsonLd={jsonLd}><SiteHeader /><main class="article-page"><nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/ediciones">Ediciones</a><span>/</span><span aria-current="page">Nº {article.number}</span></nav><header class="article-hero"><div class="article-heading"><p class="eyebrow">EDICIÓN Nº {article.number} · <a href={`/categorias/${article.categorySlug}`}>{article.category}</a></p><h1>{article.title}</h1><p class="article-deck">{article.excerpt}</p><div class="article-meta"><span>Por {article.author}</span><time datetime={article.published}>{new Date(`${article.published}T12:00:00`).toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" })}</time><span>{article.readTime} min de lectura</span></div></div>{article.image ? <figure class="article-cover"><img src={article.image} alt={`Portada editorial: ${article.title}`} width="900" height="1100" fetchpriority="high" /><figcaption>Edición Nº {article.number}.</figcaption></figure> : <div class="article-symbol" aria-hidden="true"><span>{article.category}</span></div>}</header><article class="article-body"><div class="share-quote"><span>PARA COMPARTIR</span><blockquote>“{article.excerpt}”</blockquote></div><div class="prose free-intro">{article.intro.map((paragraph, index) => index === 0 ? <p class="lead">{paragraph}</p> : <p>{paragraph}</p>)}</div><section class="premium-gate" aria-label="Contenido para miembros"><div class="premium-preview" aria-hidden="true">{article.premium.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((p) => <p>{p}</p>)}</section>)}</div><div class="gate-card"><span class="prism" aria-hidden="true"><span class="prism-beam"></span></span><p class="eyebrow">CONTENIDO PARA MIEMBROS</p><h2>La historia continúa.</h2><p>Accede a la edición completa y a todo el archivo por ${site.membership.price} {site.membership.currency} al mes.</p><a class="button button-red" href="/membresia">Hazte miembro <span>↗</span></a><a href="/acceder">Ya soy miembro: acceder</a></div></section><p class="updated">Última actualización: <time datetime={article.updated}>{article.updated}</time></p></article><aside class="related"><p class="section-index">SIGUE LEYENDO <span></span> EL ARCHIVO</p><h2>Artículos relacionados</h2><div>{related.map((item) => <a href={`/ediciones/${item.slug}`}><small>{item.category} · {item.readTime} min</small><strong>{item.title}</strong><span>↗</span></a>)}</div></aside></main><SiteFooter /></BaseLayout>
