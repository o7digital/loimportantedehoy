---
import BaseLayout from "../layouts/BaseLayout.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import MembershipDemo from "../components/MembershipDemo"; import NewsletterForm from "../components/NewsletterForm"; import { site } from "../config/site";
---
<BaseLayout title="Membresía | Lo importante de hoy" description={`Únete al club de lectores de Lo importante de hoy por ${site.membership.price} MXN al mes.`}><SiteHeader /><main class="membership-page"><header class="membership-hero"><p class="eyebrow">EL CLUB DE LOS CURIOSOS</p><h1>Menos ruido.<br /><em>Más mundo.</em></h1><p>Una membresía para leer con tiempo, criterio y belleza.</p></header><section class="membership-plan"><div><p class="eyebrow">MEMBRESÍA FUNDADORA</p><h2><small>$</small>{site.membership.price}<span>MXN<br />al mes</span></h2><p>Acceso completo a todas las ediciones y al archivo. Cancela cuando quieras.</p><MembershipDemo client:load price={site.membership.price} /><small>Demostración · Stripe aún no está conectado</small></div><ul><li><span>01</span><strong>La edición completa</strong><p>Historias cuidadas y contexto para comprender por qué importan.</p></li><li><span>02</span><strong>El archivo sin fin</strong><p>Tu biblioteca personal de cultura y memoria.</p></li><li><span>03</span><strong>Lectura sin ruido</strong><p>Una experiencia íntima, sin publicidad invasiva.</p></li><li><span>04</span><strong>Control de tu membresía</strong><p>Preparada para gestión, pagos y cancelación con Stripe.</p></li></ul></section><section class="newsletter compact"><span class="newsletter-kicker">UNA HISTORIA IMPORTANTE, CADA SEMANA</span><h2>Prueba primero la lectura gratuita.</h2><p>El formulario funciona como demostración y está listo para conectarse a tu proveedor.</p><NewsletterForm client:load /></section></main><SiteFooter /></BaseLayout>
