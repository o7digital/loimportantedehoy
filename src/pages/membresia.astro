---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MembershipPricing from "../components/MembershipPricing";
import NewsletterForm from "../components/NewsletterForm";
import { site } from "../config/site";
---
<BaseLayout title="Membresía | Lo importante de hoy" description={`Precios de lanzamiento: español ${site.membership.plans[0].price} MXN, español + inglés ${site.membership.plans[1].price} MXN y multilingüe ${site.membership.plans[2].price} MXN al mes.`}>
  <SiteHeader />
  <main class="membership-page">
    <header class="membership-hero"><p class="eyebrow">EL CLUB DE LOS CURIOSOS</p><h1>Menos ruido.<br /><em>Más mundo.</em></h1><p>Una membresía para leer con tiempo, criterio y belleza. Desde ${site.membership.price} MXN al mes.</p></header>
    <section class="membership-plan">
      <MembershipPricing client:load />
      <ul><li><span>01</span><strong>La edición completa</strong><p>Historias cuidadas y contexto para comprender por qué importan.</p></li><li><span>02</span><strong>El archivo de la revista</strong><p>Una colección de cultura y memoria para volver a leer.</p></li><li><span>03</span><strong>En tu pantalla</strong><p>La revista se adapta a desktop y móvil.</p></li><li><span>04</span><strong>Elige tu idioma</strong><p>Español, español + inglés o multilingüe. Las versiones en otros idiomas están en preparación.</p></li></ul>
    </section>
    <section class="newsletter compact"><span class="newsletter-kicker">UNA HISTORIA IMPORTANTE, CADA SEMANA</span><h2>Prueba primero la lectura gratuita.</h2><p>Descubre una edición de Lo importante de hoy.</p><NewsletterForm client:load /></section>
  </main>
  <SiteFooter />
</BaseLayout>
