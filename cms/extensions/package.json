{
  "name": "directus-extension-revista-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": { "build": "directus-extension build && node build-preview.mjs" },
  "devDependencies": { "@directus/extensions-sdk": "17.1.4", "vue": "3.5.24", "esbuild": "0.25.12" },
  "directus:extension": {
    "type": "bundle", "host": "^11.17.4", "partial": false,
    "path": { "app": "dist/app.js", "api": "dist/api.js" },
    "entries": [
      { "type": "module", "name": "revista-studio-module", "source": "src/module/index.js" },
      { "type": "endpoint", "name": "revista-studio", "source": "src/endpoint/index.js" }
    ]
  }
}
